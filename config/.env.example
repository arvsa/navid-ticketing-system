# Copy this file to config/.env (next to docker-compose.yml) to change the
# backend's settings. Values here win over docker-compose.yml. The backend
# restarts by itself within a few seconds of the file being added, changed or
# removed, as soon as nothing holds a lock on the database.
#
# One KEY=value per line; quote values with spaces: KEY="a b".
# Every setting is listed in backend/docs/REFERENCE.md (Configuration).

# The address in the browser. Must match it, or sign-in fails.
# APP_ORIGIN=https://tickets.your.school

# true behind HTTPS.
# COOKIE_SECURE=true

# RUST_LOG=backend=debug,tower_http=info,sqlx=warn
