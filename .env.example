# Settings for `docker compose` (copy to .env to change them; the defaults work).

# Port on your machine where the app is served.
APP_PORT=8000
# Must be the address you open in the browser: the backend rejects non-GET
# requests whose Origin header doesn't match.
APP_ORIGIN=http://localhost:8000
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

RUST_LOG=backend=info,tower_http=info,sqlx=warn
