# Postgres from the root docker-compose.yml. sqlx::test also uses this server to create
# throwaway test databases, so the user needs CREATEDB (the compose user is a superuser).
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
DATABASE_MAX_CONNECTIONS=10

BIND_ADDR=127.0.0.1:8080
# Origin of the frontend. Non-GET requests must send a matching Origin header.
APP_ORIGIN=http://localhost:5173
# Set to true in production (HTTPS); controls the Secure flag on the session cookie.
COOKIE_SECURE=false

# Local attachment storage (created on first upload).
STORAGE_DIR=./data/attachments

# Run SLA / reminder / cleanup jobs in this process. Safe to enable on every
# instance: an advisory lock picks one runner per tick.
JOBS_ENABLED=true

# pretty (dev) or json (prod)
LOG_FORMAT=pretty
RUST_LOG=backend=debug,tower_http=info,sqlx=warn
