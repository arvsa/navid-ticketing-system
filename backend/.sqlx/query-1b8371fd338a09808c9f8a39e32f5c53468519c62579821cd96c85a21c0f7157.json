  "query": "\n        SELECT b.id, b.code, b.name, m.joined_at\n        FROM branch_membership m\n        JOIN branch b ON b.id = m.branch_id\n        WHERE m.user_id = $1 AND m.left_at IS NULL\n        ORDER BY b.name\n        ",
