  "query": "\n        SELECT id, code, name, email::text, timezone, is_active, created_at, updated_at\n        FROM branch\n        WHERE ($1 OR id = ANY($2))\n          AND ($3::text IS NULL OR (name, id) > ($3, $4))\n        ORDER BY name, id\n        LIMIT $5\n        ",
